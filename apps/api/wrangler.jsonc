{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Vila Noel do Bem public HTTP API (IMPL-0009): read-only routes over D1. See docs/reference/api.md.
  "name": "vilanoeldobem-api",
  "account_id": "9119b7496767fec497f6627c5ca56f32",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vilanoeldobem",
      // Created 2026-11-08 (location enam), account 9119b749… (docs/guides/deploy.md).
      "database_id": "7c65d21d-0431-4ec5-bdd0-691dacb81f92",
      "migrations_dir": "../../migrations"
    }
  ],
  // Cloudflare Email Service (IMPL-0011): sends only the sign-in link. The sending domain must be onboarded
  // (docs/guides/deploy.md); until then sends fail closed with 503 "mail_unavailable".
  "send_email": [{ "name": "EMAIL" }],
  // Sign-in requests per client IP (the IP is only a rate-limit key, never stored).
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "ENVIRONMENT": "production",
    // Accounts, server XP, NGO applications and admin (IMPL-0011). Off until the LGPD / ECA Digital review.
    "ACCOUNTS_ENABLED": "false",
    "MAIL_FROM": "acesso@vilanoeldobem.com.br",
    // Exact page origins that may read the API from a browser (local dev overrides it in package.json "dev").
    "ALLOWED_ORIGINS": "https://play.vilanoeldobem.com.br,https://www.vilanoeldobem.com.br",
    // Only the game may use account routes and send the session cookie; sign-in links always open the game.
    "ACCOUNT_ORIGINS": "https://play.vilanoeldobem.com.br",
    "GAME_ORIGIN": "https://play.vilanoeldobem.com.br"
  },
  "routes": [{ "pattern": "api.vilanoeldobem.com.br", "custom_domain": true }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // Staging (docs/guides/staging-database.md): own D1, no routes, no workers.dev, no browser origins, accounts off.
  // Bindings are not inherited: staging deliberately has no EMAIL (sends fail closed) and no AUTH_LIMITER.
  "env": {
    "staging": {
      "name": "vilanoeldobem-api-staging",
      "routes": [],
      "workers_dev": false,
      "preview_urls": false,
      "send_email": [],
      "ratelimits": [],
      "vars": {
        "ENVIRONMENT": "staging",
        "ACCOUNTS_ENABLED": "false",
        "MAIL_FROM": "",
        "ALLOWED_ORIGINS": "",
        "ACCOUNT_ORIGINS": "",
        "GAME_ORIGIN": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vilanoeldobem-staging",
          // Created 2026-11-11 by the team (PR #10); synthetic data only.
          "database_id": "32ebb383-e765-4ed0-aa25-d8871be3e414",
          "migrations_dir": "../../migrations"
        }
      ]
    }
  }
}
