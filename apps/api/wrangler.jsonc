{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Vila Noel do Bem public HTTP API (IMPL-0009): read-only routes over D1. See docs/reference/api.md.
  "name": "vilanoeldobem-api",
  "account_id": "9119b7496767fec497f6627c5ca56f32",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vilanoeldobem",
      // Created 2026-11-08 (location enam), account 9119b749… (docs/guides/deploy.md).
      "database_id": "7c65d21d-0431-4ec5-bdd0-691dacb81f92",
      "migrations_dir": "../../migrations"
    }
  ],
  // E-mail goes through Resend (IMPL-0012): the API key is the Worker secret RESEND_API_KEY (never a var; see
  // docs/guides/deploy.md). Without it sign-in e-mails fail closed with 503 "mail_unavailable".
  // Sign-in requests per client IP (the IP is only a rate-limit key, never stored).
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "ENVIRONMENT": "production",
    // Accounts, server XP, NGO applications and admin (IMPL-0011). Off until the LGPD / ECA Digital review.
    "ACCOUNTS_ENABLED": "false",
    // Quests-v1 events (PROPOSTA, DEC-039..042, PEN-025). Off until the owner approves the catalog.
    "QUESTS_V1_ENABLED": "false",
    "MAIL_FROM": "acesso@vilanoeldobem.com.br",
    // Exact page origins that may read the API from a browser (local dev overrides it in package.json "dev").
    "ALLOWED_ORIGINS": "https://play.vilanoeldobem.com.br,https://www.vilanoeldobem.com.br,https://dash.vilanoeldobem.com.br",
    // Only the game and the backoffice dashboard may use account routes and send the session cookie.
    "ACCOUNT_ORIGINS": "https://play.vilanoeldobem.com.br,https://dash.vilanoeldobem.com.br",
    // Sign-in links open the game, except a link asked from exactly DASH_ORIGIN, which opens the dashboard (IMPL-0015).
    "DASH_ORIGIN": "https://dash.vilanoeldobem.com.br",
    "GAME_ORIGIN": "https://play.vilanoeldobem.com.br"
  },
  "routes": [{ "pattern": "api.vilanoeldobem.com.br", "custom_domain": true }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // Staging (docs/guides/staging-database.md): own D1, no routes, no workers.dev, no browser origins, accounts off.
  // Bindings and secrets are not inherited: staging deliberately has no RESEND_API_KEY (sends fail closed) and no
  // AUTH_LIMITER.
  "env": {
    "staging": {
      "name": "vilanoeldobem-api-staging",
      "routes": [],
      "workers_dev": false,
      "preview_urls": false,
      "ratelimits": [],
      "vars": {
        "ENVIRONMENT": "staging",
        "ACCOUNTS_ENABLED": "false",
        "QUESTS_V1_ENABLED": "false",
        "MAIL_FROM": "",
        "ALLOWED_ORIGINS": "",
        "ACCOUNT_ORIGINS": "",
        "DASH_ORIGIN": "",
        "GAME_ORIGIN": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vilanoeldobem-staging",
          // Recreated 2026-11-11 (ENAM) with main's migrations; synthetic data only (docs/guides/staging-database.md).
          "database_id": "cda0275f-6ffc-4813-8dee-efd5ae98baf4",
          "migrations_dir": "../../migrations"
        }
      ]
    }
  }
}
