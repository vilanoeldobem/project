{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Vila Noel do Bem public HTTP API (IMPL-0009): read-only routes over D1. See docs/reference/api.md.
  "name": "vilanoeldobem-api",
  "account_id": "9119b7496767fec497f6627c5ca56f32",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vilanoeldobem",
      // Created 2026-11-08 (location enam), account 9119b749… (docs/guides/deploy.md).
      "database_id": "7c65d21d-0431-4ec5-bdd0-691dacb81f92",
      "migrations_dir": "../../migrations"
    }
  ],
  // E-mail goes through Resend (IMPL-0012): the API key is the Worker secret RESEND_API_KEY (never a var; see
  // docs/guides/deploy.md). Without it sign-in e-mails fail closed with 503 "mail_unavailable".
  // Sign-in requests per client IP (the IP is only a rate-limit key, never stored); uploads per account;
  // POST /moderation/consume per caller address (IMPL-0021; a call through the service binding has no address
  // and is keyed by its room, charged only for a ticket that was issued).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
    { "name": "FILE_LIMITER", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } },
    { "name": "MODERATION_LIMITER", "namespace_id": "1103", "simple": { "limit": 60, "period": 60 } },
    // Pix charge creation (IMPL-0028), by account or by a hash of the address; only reached with DONATIONS_ENABLED.
    { "name": "DONATION_LIMITER", "namespace_id": "1104", "simple": { "limit": 10, "period": 60 } }
  ],
  // Files of NGO applications (IMPL-0017): private bucket, no public bucket URL and no custom domain; every
  // byte is served by this Worker. The bucket must be created by hand, with approval, before a deploy
  // (docs/guides/deploy.md §9). Deploy only with `pnpm deploy:api`: it passes `--x-provision=false`. A bare
  // `wrangler deploy` would CREATE a missing bucket by itself (automatic provisioning is on by default).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "vilanoeldobem-files" }],
  "vars": {
    "ENVIRONMENT": "production",
    // Accounts, server XP, NGO applications and admin (IMPL-0011). Off until the LGPD / ECA Digital review.
    "ACCOUNTS_ENABLED": "false",
    // Quests-v1 events (PROPOSTA, DEC-039..042, PEN-025). Off until the owner approves the catalog.
    "QUESTS_V1_ENABLED": "false",
    // Story-v2 events (PROPOSTA). Independent of v1; off in production.
    "QUESTS_V2_ENABLED": "false",
    // NGO logo and document uploads to R2 (PROPOSTA, IMPL-0017, PEN-019). Off until the owner approves the
    // list of documents and the LGPD review covers them. Needs ACCOUNTS_ENABLED and migration 0006.
    "NGO_FILES_ENABLED": "false",
    "NGO_PHOTOS_ENABLED": "false",
    // Administrative withdrawal of a published NGO (PROPOSTA, IMPL-0020). Off until the product owner answers
    // OQ-14 (what a withdrawal means for the account, the CNPJ, re-entry and retention). Needs ACCOUNTS_ENABLED
    // and migration 0009; it only gates new withdrawals.
    "NGO_WITHDRAWAL_ENABLED": "false",
    // Account block (PROPOSTA, IMPL-0021). Off until the product owner answers OQ-11 (which sanctions exist, who
    // applies them, appeal, duration, notice). Needs ACCOUNTS_ENABLED and migration 0010; it only gates new blocks.
    "ACCOUNT_BLOCK_ENABLED": "false",
    // Removing a visitor from a room of the realtime server (PROPOSTA, IMPL-0021). Needs ACCOUNTS_ENABLED,
    // migration 0010 and the realtime server deployed with the same flag and its service binding to this Worker.
    "PRESENCE_MODERATION_ENABLED": "false",
    // Ownership of residential plots (PROPOSTA, IMPL-0024). Off until the product owner answers OQ-17: no
    // recorded decision lets a player hold land (DEC-028 reserves plots for NGOs). Needs ACCOUNTS_ENABLED and
    // migration 0012; there is no claim route yet, so today it only changes what GET /residential-plots answers.
    "RESIDENTIAL_PLOTS_ENABLED": "false",
    // Donations and the AbacatePay reconciliation (PROPOSTA, IMPL-0023). Off until the partner contract and the
    // payment rules exist (PEN-004, PEN-006, PEN-026). Needs ACCOUNTS_ENABLED and migration 0011.
    "DONATIONS_ENABLED": "false",
    // Levels of the NGO buildings from the confirmed donation total (PROPOSTA, IMPL-0032). Off until the product
    // owner answers OQ-23 (whether a house may grow with money, on which base, what an NGO with an external
    // donation page gets). Needs DONATIONS_ENABLED; it only adds `ngo_level` to GET /lots.
    "NGO_LEVELS_ENABLED": "false",
    "MAIL_FROM": "acesso@vilanoeldobem.com.br",
    // Exact page origins that may read the API from a browser (local dev overrides it in package.json "dev").
    "ALLOWED_ORIGINS": "https://play.vilanoeldobem.com.br,https://www.vilanoeldobem.com.br,https://dash.vilanoeldobem.com.br",
    // Only the game and the backoffice dashboard may use account routes and send the session cookie.
    "ACCOUNT_ORIGINS": "https://play.vilanoeldobem.com.br,https://dash.vilanoeldobem.com.br",
    // Sign-in links open the game, except a link asked from exactly DASH_ORIGIN, which opens the dashboard (IMPL-0015).
    "DASH_ORIGIN": "https://dash.vilanoeldobem.com.br",
    "GAME_ORIGIN": "https://play.vilanoeldobem.com.br"
  },
  "routes": [{ "pattern": "api.vilanoeldobem.com.br", "custom_domain": true }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // Staging uses its own Worker, D1, login rate limit and sibling browser origins.
  // Keep accounts off until the sender, staging-only Resend secret and schema are ready.
  "env": {
    "staging": {
      "name": "vilanoeldobem-api-staging",
      "routes": [{ "pattern": "api-staging.vilanoeldobem.com.br", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "2101", "simple": { "limit": 10, "period": 60 } }],
      "r2_buckets": [],
      "vars": {
        "ENVIRONMENT": "staging",
        "STAGING_ACCOUNT_ACTIONS": "false",
        "ACCOUNTS_ENABLED": "false",
        "QUESTS_V1_ENABLED": "false",
        "QUESTS_V2_ENABLED": "false",
        "NGO_FILES_ENABLED": "false",
        "NGO_PHOTOS_ENABLED": "false",
        "NGO_WITHDRAWAL_ENABLED": "false",
        "ACCOUNT_BLOCK_ENABLED": "false",
        "PRESENCE_MODERATION_ENABLED": "false",
        "RESIDENTIAL_PLOTS_ENABLED": "false",
        "DONATIONS_ENABLED": "false",
        "NGO_LEVELS_ENABLED": "false",
        "MAIL_FROM": "acesso@vilanoeldobem.com.br",
        "ALLOWED_ORIGINS": "https://play-staging.vilanoeldobem.com.br,https://www-staging.vilanoeldobem.com.br,https://dash-staging.vilanoeldobem.com.br",
        "ACCOUNT_ORIGINS": "https://play-staging.vilanoeldobem.com.br,https://dash-staging.vilanoeldobem.com.br",
        "DASH_ORIGIN": "https://dash-staging.vilanoeldobem.com.br",
        "GAME_ORIGIN": "https://play-staging.vilanoeldobem.com.br"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vilanoeldobem-staging",
          // Recreated 2026-11-11 (ENAM) with main's migrations; synthetic data only (docs/guides/staging-database.md).
          "database_id": "cda0275f-6ffc-4813-8dee-efd5ae98baf4",
          "migrations_dir": "../../migrations"
        }
      ]
    }
  }
}
