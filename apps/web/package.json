{
  "name": "@vila/web",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "description": "Vila Noel do Bem — 3D client (React + Three.js) and Cloudflare Worker (Static Assets + D1)",
  "scripts": {
    "dev": "vite",
    "dev:worker": "vite build && wrangler dev --local --infer-origin-from-routes=false",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply vilanoeldobem --local",
    "db:migrate:remote": "wrangler d1 migrations apply vilanoeldobem --remote",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
