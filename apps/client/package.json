{
  "name": "@vila/client",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "description": "Vila Noel do Bem \u2014 3D game client (React + Three.js) on Workers Static Assets (play.vilanoeldobem.com.br)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:local": "tsc --noEmit -p . && vite build --mode workers",
    "preview": "vite preview",
    "dev:worker": "pnpm build:local && wrangler dev --local --port 8799 --infer-origin-from-routes=false",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@vila/shared": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "@types/node": "^24.19.2"
  }
}
