    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
