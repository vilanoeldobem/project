{
  "name": "vilanoeldobem",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "description": "Vila Noel do Bem — virtual 3D voxel Christmas village (monorepo)",
  "scripts": {
    "dev": "pnpm --filter @vila/web dev",
    "dev:site": "pnpm --filter @vila/site dev",
    "dev:worker": "pnpm --filter @vila/web dev:worker",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm --filter @vila/web run deploy",
    "deploy:site": "pnpm --filter @vila/site run deploy"
  },
  "packageManager": "pnpm@10.32.1"
}
