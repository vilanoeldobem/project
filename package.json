{
  "name": "vilanoeldobem",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "description": "Vila Noel do Bem — virtual 3D voxel Christmas village (monorepo: site, client, api, server, shared)",
  "scripts": {
    "dev": "pnpm --parallel --filter @vila/client --filter @vila/api --filter @vila/server run dev",
    "dev:site": "pnpm --filter @vila/site dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "db:migrate:local": "pnpm --filter @vila/api db:migrate:local",
    "deploy:api": "pnpm --filter @vila/api run deploy",
    "deploy:server": "pnpm --filter @vila/server run deploy",
    "deploy:client": "pnpm --filter @vila/client run deploy",
    "deploy:site": "pnpm --filter @vila/site run deploy"
  },
  "packageManager": "pnpm@10.32.1"
}
